# oh-my-sage MCP Server - Docker 部署配置（私有服务器 / NAS）
# 复制为 deploy/.env 后修改，不要提交 .env。

# 米家网关局域网地址
GATEWAY_URL=http://192.168.0.5

# ==================== 小米账号登录态（可选） ====================

# 推荐：在 Web 登录页用米家 App 扫码。登录态保存在 .sessionstore/mijia-auth.json，
# 之后自动取码，失效前无需重复扫码。
# MCP 与 Web 使用同一工作目录时会自动读取该文件；Docker 可用 MIJIA_AUTH_FILE
# 指向挂载进来的登录态文件。
# MIJIA_AUTH_FILE=/data/mijia-auth.json

# 备用：手动填写环境变量（Web 扫码不可用或需要固定账号时）
# 从浏览器登录 account.xiaomi.com 后复制 Cookie：
# MIJIA_COOKIE=userId=...; passToken=...; cUserId=...; deviceId=...
# 或分别填写（前两项必填）：
# MIJIA_USER_ID=
# MIJIA_PASS_TOKEN=
# MIJIA_C_USER_ID=
# MIJIA_DEVICE_ID=

# 签发登录码的设备 DID（可选；留空时按 GATEWAY_URL 的 IP 自动匹配）
# MIJIA_ROUTER_DID=

# 客户端连接时携带的 Bearer token，生成方式：openssl rand -hex 32
MCP_AUTH_TOKEN=change-me-to-a-long-random-string

# 客户端访问服务器时使用的主机名或 IP（逗号分隔），否则请求会被 Host 校验拒绝（403）
MCP_ALLOWED_HOSTS=192.168.0.10,nas.local

# 宿主机映射端口
MCP_PORT=3790

# 会话空闲回收时间（分钟），可选
# MCP_SESSION_TTL_MINUTES=30
