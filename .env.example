# oh-my-sage 配置文件

# ==================== LLM 配置 ====================

# OpenAI 兼容接口配置
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=your_api_key_here
LLM_MODEL=gpt-4o

# 温度（可选，默认 0.7）
# LLM_TEMPERATURE=0.7

# ==================== 网关配置 ====================

# 米家网关地址
GATEWAY_URL=http://192.168.0.5

# ==================== 小米账号登录态（可选） ====================

# 推荐：启动 Web 界面后在登录页用米家 App 扫码登录。登录态会保存在
# .sessionstore/mijia-auth.json，之后打开页面会自动取码，失效前无需重复扫码。
# 只有不使用 Web 扫码、或需要备用凭据时，才需要手动填写下面的环境变量。
#
# 凭据等同于小米账号登录态，只填写在本机 .env 或私有部署环境变量中，不要提交。
# 获取方式：浏览器登录 https://account.xiaomi.com 后，在开发者工具中复制
# Cookie 里的 userId 和 passToken；也可以把整段 Cookie 粘贴到 MIJIA_COOKIE。
# MIJIA_COOKIE=userId=...; passToken=...; cUserId=...; deviceId=...
# MIJIA_USER_ID=
# MIJIA_PASS_TOKEN=
# MIJIA_C_USER_ID=
# MIJIA_DEVICE_ID=

# 扫码登录态文件路径（可选；默认当前工作目录下的 .sessionstore/mijia-auth.json）
# MIJIA_AUTH_FILE=.sessionstore/mijia-auth.json

# 签发登录码的设备 DID（可选；留空时按 GATEWAY_URL 的 IP 从云端设备列表自动匹配）
# MIJIA_ROUTER_DID=
